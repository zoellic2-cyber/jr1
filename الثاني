local function bindClick(btn, fn)
    local last=0
    local function h()
        local n=os.clock()
        if n-last<0.3 then return end
        last=n
        pcall(fn)
    end
    btn.MouseButton1Click:Connect(h)
    btn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch then h() end
    end)
end

