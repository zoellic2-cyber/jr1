-- Orbita em volta do alvo batendo M1.
-- getTarget() deve retornar {Part=..., Humanoid=opcional} ou nil.
local function orbitTarget(getTarget, flag)
    local angle=0
    local t0=os.clock()
    local lastPathT=0

    while flag() and not State.dead do
        local target=getTarget()
        if not target or not target.Part or not target.Part.Parent then
            return
        end
        if target.Humanoid and target.Humanoid.Health<=0 then
            return
        end

        local hrp=getHRP()
        if not hrp then task.wait(0.2); return end

        local tp=target.Part.Position
        local dist=(tp-hrp.Position).Magnitude

        if dist > Cfg.OrbitRadius+4 then
            -- longe: aproxima (recalcula a cada 1s)
            local now=os.clock()
            if (now-lastPathT)>1.0 then
                lastPathT=now
                local dir=hrp.Position-tp
                if dir.Magnitude<0.01 then dir=Vector3.new(1,0,0) end
                dir=Vector3.new(dir.X,0,dir.Z).Unit
                local approach=tp + dir*(Cfg.OrbitRadius+2)
                goTo(approach+Vector3.new(0,Cfg.YOffset,0), flag)
            else
                task.wait(0.1)
            end
        else
            -- perto: orbita batendo
            local now=os.clock()
            local dt=math.min(now-t0,0.1); t0=now
            angle=angle + Cfg.OrbitSpeed*dt
            local px=tp.X + math.cos(angle)*Cfg.OrbitRadius
            local pz=tp.Z + math.sin(angle)*Cfg.OrbitRadius
            local py=tp.Y + 3
            pcall(function()
                hrp.CFrame=CFrame.lookAt(Vector3.new(px,py,pz), tp)
            end)
            clickM1()
            task.wait(0.03)
        end
    end
end

