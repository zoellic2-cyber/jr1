local function stopTween()
    if State.activeTween then
        pcall(function() State.activeTween:Cancel() end)
        State.activeTween=nil
    end
end

local function clearLine(a, b)
    local flat=Vector3.new(b.X-a.X,0,b.Z-a.Z)
    if flat.Magnitude<0.1 then return true end
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={LP.Character,ESP_F,NODE_F}
    local lift=Vector3.new(0,2,0)
    local dir=flat.Unit
    local side=dir:Cross(Vector3.yAxis)
    local r=Cfg.AgentRadius
    local offsets={
        Vector3.zero,
        side*r, -side*r,
        dir*r, -dir*r,
        (side+dir).Unit*r, (side-dir).Unit*r,
        (-side+dir).Unit*r, (-side-dir).Unit*r,
    }
    for _,off in ipairs(offsets) do
        if workspace:Raycast(a+off+lift, flat, rp) then return false end
    end
    return true
end

local function sameLevel(a, b)
    return math.abs(b.Y-a.Y) <= 3
end

local function moveTo(pos, flag)
    local hrp=getHRP(); if not hrp then return false end
    if (pos-hrp.Position).Magnitude < Cfg.ReachDist then return true end
    if math.abs(pos.Y - hrp.Position.Y) > 3 then return false end

    local dur=math.min(
        math.max((pos-hrp.Position).Magnitude/Cfg.WalkSpeed, 0.05),
        Cfg.MoveCapDuration
    )
    stopTween()
    State.activeTween=TweenService:Create(hrp,
        TweenInfo.new(dur, Enum.EasingStyle.Linear),
        {CFrame=CFrame.lookAt(pos, pos+hrp.CFrame.LookVector)})
    State.activeTween:Play()

    local t0=os.clock()
    while os.clock()-t0<dur+0.15 do
        if not flag() or State.modeChanged or State.moveLock then
            stopTween(); return false
        end
        if not getHRP() then stopTween(); return false end
        task.wait()
    end
    stopTween()

    local h2=getHRP(); if not h2 then return false end
    return (pos-h2.Position).Magnitude <= Cfg.ReachDist+2
end

local function compressPath(wps)
    if #wps<=2 then return wps end
    local start=wps[1]
    local far=wps[2]
    for j=#wps,2,-1 do
        local cand=wps[j]
        if cand.Action==Enum.PathWaypointAction.Jump then
            far=cand; break
        end
        if (cand.Position-start.Position).Magnitude<=Cfg.MaxSkipDist
           and clearLine(start.Position, cand.Position) then
            far=cand; break
        end
        far=cand
    end
    return {start, far}
end

local function goTo(target, flag)
    if State.moveLock then return false end
    local attempts=0
    while flag() and not State.dead do
        attempts=attempts+1
        if attempts>30 then return false end

        local hrp=getHRP()
        if not hrp then return false end
        if (target-hrp.Position).Magnitude<=Cfg.ReachDist then
            clearTrajectory(); return true
        end

        if sameLevel(hrp.Position, target) and clearLine(hrp.Position, target) then
            showTrajectory({hrp.Position, target})
            local ok=moveTo(target, flag)
            clearTrajectory()
            if ok then return true end
            task.wait(0.1)
        end

        local path=PathfindingService:CreatePath({
            AgentRadius=Cfg.AgentRadius,
            AgentHeight=Cfg.AgentHeight,
            AgentCanJump=true,
            AgentMaxSlope=45,
        })
        local ok=pcall(function() path:ComputeAsync(hrp.Position, target) end)
        if not ok or (path.Status~=Enum.PathStatus.Success
            and path.Status~=Enum.PathStatus.ClosestNoPath) then
            task.wait(0.2); return false
        end
        local wps=path:GetWaypoints()
        if not wps or #wps<2 then return false end

        wps=compressPath(wps)
        local viz={}
        for _,w in ipairs(wps) do
            viz[#viz+1]=w.Position+Vector3.new(0,Cfg.YOffset,0)
        end
        showTrajectory(viz)

        local wp=wps[2]
        local pos=wp.Position+Vector3.new(0,Cfg.YOffset,0)

        if wp.Action==Enum.PathWaypointAction.Jump then
            local hum=LP.Character and LP.Character:FindFirstChildOfClass(qMejctBnDbxiaCKNvsLKHWtDgCFmlRDeMitfiodRhihUTHOqPVGqF('MlQDRvJCESsHcVQmcgSFrDhZOxydcjHPENYPGmuCuCluKVaYPDwMWigSHVtYW5vaWQ='))
            if hum then hum.Jump=true end
            task.wait(0.25)
        else
            local t0=os.clock()
            local reached=false
            while os.clock()-t0<Cfg.WaypointTimeout do
                if not flag() then clearTrajectory(); return false end
                local ok2=moveTo(pos, flag)
                if ok2 then reached=true; break end
                local h2=getHRP()
                if h2 and (h2.Position-pos).Magnitude<=Cfg.ReachDist+3 then
                    reached=true; break
                end
            end
            if not reached then task.wait(0.05) end
        end
        clearTrajectory()
    end
    return false
end

local function navigateToDoor(part, flag, doorCheck)
    if not part or not part.Parent then return false end
    local hrp=getHRP(); if not hrp then return false end

    local curDist=(part.Position-hrp.Position).Magnitude
    if curDist>=Cfg.ReachDist and curDist<=Cfg.DoorStandoff+2 then
        return true
    end

    for _,p in ipairs(doorApproachPoints(part)) do
        if not flag() then return false end
        if doorCheck and not doorCheck() then return false end
        local target=p+Vector3.new(0,Cfg.YOffset,0)
        local ok=goTo(target, function()
            if not flag() then return false end
            if doorCheck and not doorCheck() then return false end
            return true
        end)
        if ok then
            local h2=getHRP()
            if h2 then
                local d=(part.Position-h2.Position).Magnitude
                if d>=Cfg.ReachDist and d<=Cfg.DoorStandoff+2 then
                    return true
                end
            end
        end
    end
    return false
end

