-- nearestDoor: prioriza vazias, pula usadas e skip
local function nearestDoor(includeUsed)
    pruneSkip()
    if (os.clock()-State.doors.last>Cfg.DoorRefreshInterval) or #State.doors.list==0 then
        refreshDoors(); State.doors.last=os.clock()
    end
    local hrp=getHRP(); if not hrp then return nil end
    local bestEmpty, bdEmpty = nil, math.huge
    local bestAny,   bdAny   = nil, math.huge

    for _,d in ipairs(State.doors.list) do
        if d.Part and d.Part.Parent
           and not State.doors.skip[d.Model]
           and (includeUsed or not State.usedDoors[d.Model]) then
            local dist=(d.Part.Position-hrp.Position).Magnitude
            local hasPlayer=playerNearPart(d.Part)
            local entry={
                Model=d.Model, Part=d.Part,
                Distance=math.floor(dist),
                Timer=doorTimer(d.Model),
                HasPlayer=hasPlayer,
            }
            if dist<bdAny then bdAny=dist; bestAny=entry end
            if not hasPlayer and dist<bdEmpty then
                bdEmpty=dist; bestEmpty=entry
            end
        end
    end

    if Cfg.IgnoreDoorWithPlayers then return bestEmpty end
    return bestAny
end

local function doorApproachPoints(part)
    local cf=part.CFrame; local s=Cfg.DoorStandoff
    return {
        (cf*CFrame.new(0,0,s)).Position,
        (cf*CFrame.new(0,0,-s)).Position,
        (cf*CFrame.new(s,0,0)).Position,
        (cf*CFrame.new(-s,0,0)).Position,
        part.Position,
    }
end

