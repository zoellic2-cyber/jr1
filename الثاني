-- Dispara UM prompt (o mais perto). Retorna true se disparou algum.
local function fireOnePromptClosest(model)
    if not model or not model.Parent then return false end
    local best, bd = nil, math.huge
    for _,p in ipairs(model:GetDescendants()) do
        if p:IsA(qMejctBnDbxiaCKNvsLKHWtDgCFmlRDeMitfiodRhihUTHOqPVGqF('aJvCSgQsqoivQqlhBVQCmuscnUgBCzOAdNAicXEhYFsrwKGQGMWyQqWUHJveGltaXR5UHJvbXB0')) then
            local d = promptDistance(p)
            if d < bd then bd=d; best=p end
        end
    end
    if not best then return false end

    pcall(function()
        best.Enabled=true
        best.MaxActivationDistance=math.max(best.MaxActivationDistance or 10, 40)
        best.RequiresLineOfSight=false
    end)

    -- 1) fireproximityprompt (executor)
    if fireproximityprompt then
        if pcall(function() fireproximityprompt(best) end) then return true end
    end

    -- 2) Triggered:Fire
    local okTriggered=false
    pcall(function()
        if best.Triggered then best.Triggered:Fire(LP); okTriggered=true end
    end)
    if okTriggered then return true end

    -- Só tenta Hold / E se estiver a até 40 studs
    if bd > 40 then return false end

    -- 3) InputHoldBegin/End
    local hold=tonumber(best.HoldDuration) or 0
    pcall(function()
        best:InputHoldBegin()
        task.wait(math.max(hold,0)+0.12)
        best:InputHoldEnd()
    end)

    -- 4) Tecla E (mouse no centro, 1 tentativa — sem loop)
    pcall(function()
        local cam=workspace.CurrentCamera
        if cam then
            local vp=cam.ViewportSize
            VIM:SendMouseMoveEvent(Vector2.new(vp.X/2, vp.Y/2), workspace)
            task.wait()
        end
    end)
    pressE()

    return true
end

-- Retorna true se conseguiu disparar em até `seconds`. Sem repetir E.
local function firePromptOnce(model, seconds)
    seconds = seconds or 1
    local t0 = os.clock()
    while os.clock()-t0 < seconds do
        if fireOnePromptClosest(model) then
            return true
        end
        task.wait(0.1)
    end
    return false
end

