local FilesTab = Window:CreateTab("📂 Files", nil)

FilesTab:CreateSection("🗂️ عرض أبواب مسار Workspace.Effects مباشرة")

local doorsParagraph = FilesTab:CreateParagraph({
    Title = "الأبواب غير المفتوحة",
    Content = "اضغط زر الفحص لعرض الأبواب.",
})

local lastDoorsClipboard = ""

FilesTab:CreateButton({
    Name = "📋 فحص وجلب الأبواب وترتيبها بالأقرب",
    Callback = function()
        local doors = getDoors(true)
        local lines = {}
        local clipLines = {}
        for index, d in ipairs(doors) do
            local pos = d.Position
            local result = doorResults[d.Object]
            local mark = result and ("  [" .. result .. "]") or ""
            local saved, savedDist = pickSavedCandidate(pos)
            local savedText = saved and string.format("  S#%d(%.1f)", saved.index, savedDist) or "  بدون نقطة محفوظة"
            local roofText = ""
            local okRoof, roof = pcall(function()
                return (findRoofPoint(buildContext(d.Object), pos, true))
            end)
            if okRoof and roof then
                roofText = string.format("  R#%d(%s)", roof.saved.index, roof.confirmed and "مؤكد" or "غير مؤكد")
            end
            if index <= 25 then
                table.insert(lines, string.format("#%d  %.0f  (%.1f, %.1f, %.1f)%s%s%s", index, d.Distance, pos.X, pos.Y, pos.Z, savedText, roofText, mark))
            end
            table.insert(clipLines, string.format("Workspace.Effects.%s | Dist: %.1f | Pos: (%.2f, %.2f, %.2f)", DOOR_NAME, d.Distance, pos.X, pos.Y, pos.Z))
        end
        if #doors > 25 then
            table.insert(lines, "... و " .. (#doors - 25) .. " أبواب أخرى")
        end
        if #doors == 0 then
            table.insert(lines, "ما فيه أبواب غير مفتوحة حالياً.")
        end
        lastDoorsClipboard = table.concat(clipLines, "\n")
        pcall(function()
            doorsParagraph:Set({
                Title = "الأبواب غير المفتوحة: " .. #doors,
                Content = table.concat(lines, "\n"),
            })
        end)
        notify("📂 تم الفحص", "تم العثور على " .. #doors .. " باب غير مفتوح مرتبة بالأقرب.", 3)
    end,
})

FilesTab:CreateButton({
    Name = "📎 نسخ مسارات وإحداثيات الأبواب",
    Callback = function()
        local copyFn = setclipboard or toclipboard
        if copyFn and lastDoorsClipboard ~= "" then
            pcall(copyFn, lastDoorsClipboard)
            notify("📋 تم النسخ", "تم نسخ قائمة الأبواب.", 3)
        else
            notify("⚠️ تعذّر النسخ", "اضغط زر الفحص أول، أو الـ executor ما يدعم الحافظة.", 3)
        end
    end,
})

FilesTab:CreateSection("📌 النقاط المحفوظة")

FilesTab:CreateButton({
    Name = "📌 حفظ موقعي الحالي كنقطة وقوف (وينسخ الـ 12 رقم)",
    Callback = function()
        local _, hrp = getAlive()
        if not hrp then
            notify("⚠️ ما فيه شخصية", "انتظر لين تظهر الشخصية.", 3)
            return
        end
        local parts = {}
        for i, v in ipairs({ hrp.CFrame:GetComponents() }) do
            parts[i] = string.format("%.6f", v)
        end
        local text = table.concat(parts, ", ")
        table.insert(savedTransforms, { index = #savedTransforms + 1, cf = hrp.CFrame, source = "user" })
        markSavedDuplicates()
        local copyFn = setclipboard or toclipboard
        if copyFn then
            pcall(copyFn, text)
        end
        print("[HalloweenDoors] saved transform #" .. #savedTransforms .. ": " .. text)
        notify("📌 تم الحفظ", "النقطة #" .. #savedTransforms .. " (لهذه الجلسة). الأرقام انطبعت في الـ Console وانسخت إذا الحافظة مدعومة.", 4)
    end,
})
