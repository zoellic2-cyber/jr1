local function notify(title, content, duration)
    if unloaded then return end
    pcall(function()
        Rayfield:Notify({ Title = title, Content = content, Duration = duration or 3 })
    end)
end

local function debugLog(fmt, ...)
    if not debugMode then return end
    local okFmt, text = pcall(string.format, fmt, ...)
    print("[HalloweenDoors] " .. (okFmt and text or tostring(fmt)))
end

local function setState(newState)
    if currentState ~= newState then
        debugLog("state %s -> %s", currentState, newState)
        currentState = newState
    end
end

local function isActive(gen)
    return autoMoveEnabled and gen == runGeneration and not unloaded
end

-- Returns character, root part and humanoid only while the character is alive.
local function getAlive()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hrp.Parent and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function sendKey(key, down)
    pcall(function()
        VirtualInputManager:SendKeyEvent(down, key, false, game)
    end)
    if down then
        heldKeys[key] = true
    else
        heldKeys[key] = nil
    end
end

local function releaseAllKeys()
    local pending = {}
    for key in pairs(heldKeys) do
        table.insert(pending, key)
    end
    for _, key in ipairs(pending) do
        sendKey(key, false)
    end
end

local function getObjectCFrame(object)
    if object:IsA("BasePart") then
        return object.CFrame
    elseif object:IsA("Model") then
        return object:GetPivot()
    end
    return nil
end

-- Heuristic door state check. The real door structure must be verified in-game.
local function isDoorOpen(door)
    if not door or not door.Parent then return true end

    if door:GetAttribute("Opened") == true or door:GetAttribute("IsOpened") == true then
        return true
    end

    local flag = door:FindFirstChild("Opened") or door:FindFirstChild("IsOpened")
    if flag then
        if flag:IsA("BoolValue") then
            return flag.Value
        end
        return true
    end

    local doorPart = door
    if not door:IsA("BasePart") then
        doorPart = door:FindFirstChild("Door")
    end
    if doorPart then
        if doorPart:IsA("BasePart") then
            return doorPart.Transparency > 0.8
        elseif doorPart:IsA("Model") then
            local anyPart = false
            local allHidden = true
            for _, d in ipairs(doorPart:GetDescendants()) do
                if d:IsA("BasePart") then
                    anyPart = true
                    if d.Transparency <= 0.8 then
                        allHidden = false
                        break
                    end
                end
            end
            return anyPart and allHidden
        end
    end

    return false
end

-- Returns the doors that are still closed, sorted nearest-first.
local function getDoors(includeVisited)
    local list = {}
    local effects = Workspace:FindFirstChild(EFFECTS_NAME)
    if not effects then return list end

    local _, hrp = getAlive()
    for _, obj in ipairs(effects:GetChildren()) do
        if obj.Name == DOOR_NAME and not isDoorOpen(obj) and (includeVisited or not visitedDoors[obj]) then
            local cf = getObjectCFrame(obj)
            if cf then
                local dist = hrp and (hrp.Position - cf.Position).Magnitude or 0
                table.insert(list, { Object = obj, CFrame = cf, Position = cf.Position, Distance = dist })
            end
        end
    end

    table.sort(list, function(a, b)
        return a.Distance < b.Distance
    end)
    return list
end

-- Path used (from the user's description, not verified in-game): Workspace.Characters.<name>.Info.Pumpkin
-- The name always comes from the player being inspected, never a hard-coded value.
local function hasPumpkin(name)
    local characters = Workspace:FindFirstChild("Characters")
    local holder = characters and characters:FindFirstChild(name)
    local info = holder and holder:FindFirstChild("Info")
    local pumpkin = info and info:FindFirstChild("Pumpkin")
    return pumpkin ~= nil
end

local function checkPumpkin()
    return hasPumpkin(player.Name)
end

-- =========================================================
-- Character protection (anti-ragdoll / anti-push lock)
-- =========================================================

local function protectHumanoid(hum)
    if protectedHumanoid ~= hum then
        protectedHumanoid = hum
        stateBackup = {}
        for _, state in ipairs(PROTECTED_STATES) do
            local okGet, enabled = pcall(function()
                return hum:GetStateEnabled(state)
            end)
            if okGet then
                stateBackup[state] = enabled
            else
                stateBackup[state] = true
            end
        end
    end
    for _, state in ipairs(PROTECTED_STATES) do
        pcall(function()
            hum:SetStateEnabled(state, false)
        end)
    end
end

local function restoreHumanoid()
    local hum = protectedHumanoid
    if hum and hum.Parent then
        for state, enabled in pairs(stateBackup) do
            pcall(function()
                hum:SetStateEnabled(state, enabled)
            end)
        end
        hum.PlatformStand = false
    end
    protectedHumanoid = nil
    stateBackup = {}
end

-- Zero walk and jump while parked; the old values are restored afterwards.
local function freezeMovement(hum)
    if frozen and frozen.hum == hum then return end
    frozen = {
        hum = hum,
        walk = hum.WalkSpeed,
        jumpPower = hum.JumpPower,
        jumpHeight = hum.JumpHeight,
    }
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.JumpHeight = 0
end

local function unfreezeMovement()
    if frozen then
        local hum = frozen.hum
        if hum and hum.Parent then
            hum.WalkSpeed = frozen.walk
            hum.JumpPower = frozen.jumpPower
            hum.JumpHeight = frozen.jumpHeight
        end
        frozen = nil
    end
end

local function releaseLock()
    lockedCFrame = nil
    cameraTarget = nil
    unfreezeMovement()
    if anchoredByScript then
        local _, hrp = getAlive()
        if hrp then hrp.Anchored = false end
        anchoredByScript = false
    end
end

local function setProtection(on)
    protectionActive = on
    if on then
        local _, _, hum = getAlive()
        if hum then protectHumanoid(hum) end
    else
        interacting = false
        releaseLock()
        restoreHumanoid()
    end
end

-- Pre-physics lock, gated by protectionActive. This is the only place that writes the locked position.
table.insert(connections, RunService.Stepped:Connect(function()
    if not protectionActive then return end
    local _, hrp, hum = getAlive()
    if not hrp then return end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    if lockedCFrame then
        hrp.CFrame = lockedCFrame
    end
    if hum then
        -- PlatformStand is suspended only while key input is being sent.
        local desired = not interacting
        if hum.PlatformStand ~= desired then
            hum.PlatformStand = desired
        end
        if frozen and frozen.hum == hum and hum.WalkSpeed ~= 0 then
            hum.WalkSpeed = 0
        end
    end
end))

-- Post-physics drift correction: snaps back if something pushed the character.
table.insert(connections, RunService.Heartbeat:Connect(function()
    if not protectionActive or not lockedCFrame then return end
    local _, hrp = getAlive()
    if hrp and (hrp.Position - lockedCFrame.Position).Magnitude > DRIFT_LIMIT then
        hrp.CFrame = lockedCFrame
    end
end))

-- Drop stale references when the character respawns.
table.insert(connections, player.CharacterAdded:Connect(function()
    lockedCFrame = nil
    cameraTarget = nil
    anchoredByScript = false
    protectedHumanoid = nil
    stateBackup = {}
    frozen = nil
    interacting = false
    releaseAllKeys()
end))

-- =========================================================
-- Camera: look at the door being opened
-- =========================================================

pcall(function() RunService:UnbindFromRenderStep(CAMERA_BIND) end)
RunService:BindToRenderStep(CAMERA_BIND, Enum.RenderPriority.Camera.Value + 1, function()
    if not cameraTarget or not cameraLookEnabled then return end
    local cam = Workspace.CurrentCamera
    local _, hrp = getAlive()
    if not cam or not hrp then return end

    local away = Vector3.new(hrp.Position.X - cameraTarget.X, 0, hrp.Position.Z - cameraTarget.Z)
    if away.Magnitude < 0.05 then return end
    local camPos = hrp.Position + away.Unit * CAMERA_DISTANCE + Vector3.new(0, CAMERA_HEIGHT, 0)
    cam.CFrame = CFrame.lookAt(camPos, cameraTarget)
end)

