-- Marks exact duplicates (same spot and same facing). Every record is kept; later copies just point at the first.
local function markSavedDuplicates()
    for i, a in ipairs(savedTransforms) do
        a.dupOf = nil
        for j = 1, i - 1 do
            local b = savedTransforms[j]
            if not b.dupOf
                and (a.cf.Position - b.cf.Position).Magnitude <= DUP_DIST
                and a.cf.LookVector:Dot(b.cf.LookVector) >= DUP_DOT then
                a.dupOf = b.index
                break
            end
        end
    end
end
markSavedDuplicates()

