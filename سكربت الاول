-- Door ESP (event driven)
-- =========================================================

local function removeESP(door)
    local hl = espHighlights[door]
    espHighlights[door] = nil
    if hl then
        pcall(function() hl:Destroy() end)
    end
end

local function addESP(door)
    if unloaded or not halloweenESPEnabled then return end
    if not door or not door.Parent or isDoorOpen(door) then return end
    local existing = espHighlights[door]
    if existing and existing.Parent then return end

    local hl = Instance.new("Highlight")
    hl.Name = "DoorHighlight"
    hl.Adornee = door
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = Color3.fromRGB(255, 170, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.Parent = door
    espHighlights[door] = hl
end

local function disconnectEffectsConns()
    for i, c in pairs(espEffectsConns) do
        pcall(function() c:Disconnect() end)
        espEffectsConns[i] = nil
    end
end

local function bindEffects(folder)
    disconnectEffectsConns()
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == DOOR_NAME then
            addESP(obj)
        end
    end
    espEffectsConns[1] = folder.ChildAdded:Connect(function(obj)
        if obj.Name == DOOR_NAME then
            task.delay(0.25, addESP, obj)
        end
    end)
    espEffectsConns[2] = folder.ChildRemoved:Connect(function(obj)
        removeESP(obj)
    end)
end

local function stopESP()
    halloweenESPEnabled = false
    espGeneration = espGeneration + 1
    disconnectEffectsConns()
    if espWorkspaceConn then
        pcall(function() espWorkspaceConn:Disconnect() end)
        espWorkspaceConn = nil
    end
    for door in pairs(espHighlights) do
        removeESP(door)
    end
end

local function startESP()
    stopESP()
    halloweenESPEnabled = true
    local gen = espGeneration

    local effects = Workspace:FindFirstChild(EFFECTS_NAME)
    if effects then
        bindEffects(effects)
    end
    -- Re-bind if the Effects folder is recreated.
    espWorkspaceConn = Workspace.ChildAdded:Connect(function(child)
        if child.Name == EFFECTS_NAME and halloweenESPEnabled then
            bindEffects(child)
        end
    end)

    -- Light refresh: drop highlights of doors that were opened.
    task.spawn(function()
        while halloweenESPEnabled and not unloaded and gen == espGeneration do
            for door in pairs(espHighlights) do
                if not door.Parent or isDoorOpen(door) then
                    removeESP(door)
                end
            end
            task.wait(1.5)
        end
    end)
end

-- =========================================================
-- Geometry checks (Raycast / overlap)
-- =========================================================

-- Raycast and overlap filters shared by every check. The door may be nil (e.g. for the high-altitude holds).
local function buildContext(door)
    local filter = {}
    if door then
        table.insert(filter, door)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(filter, plr.Character)
        end
    end

    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = filter
    ray.RespectCanCollide = true

    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = filter

    return { ray = ray, overlap = overlap }
end

local function getStandHeight(hrp, hum)
    if hum.RigType == Enum.HumanoidRigType.R15 then
        return hum.HipHeight + hrp.Size.Y / 2
    end
    return 3
end

local function isLineClear(ctx, a, b)
    return Workspace:Raycast(a, b - a, ctx.ray) == nil
end

local function isBodyClear(ctx, pos)
    local parts = Workspace:GetPartBoundsInBox(CFrame.new(pos), BODY_SIZE, ctx.overlap)
    for _, p in ipairs(parts) do
        if p.CanCollide then
            return false
        end
    end
    return true
end

-- Five parallel vertical rays, so the whole body width can pass without touching anything.
local function isColumnClear(ctx, x, z, topY, bottomY)
    if topY <= bottomY then return true end
    for _, off in ipairs(COLUMN_OFFSETS) do
        local a = Vector3.new(x + off[1], topY, z + off[2])
        local b = Vector3.new(x + off[1], bottomY, z + off[2])
        if not isLineClear(ctx, a, b) then
            return false
        end
    end
    return true
end

-- Three parallel horizontal rays between two points.
local function isPathClear(ctx, a, b)
    local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    if flat.Magnitude < 0.01 then return true end
    local side = flat.Unit:Cross(Vector3.yAxis)
    for _, o in ipairs({ 0, 1, -1 }) do
        local off = side * o
        if not isLineClear(ctx, a + off, b + off) then
            return false
        end
    end
    return true
end

-- Floor-based position for a given X/Z; the second value tells whether a floor was found.
local function groundPoint(ctx, x, z, refY, standHeight)
    local hit = Workspace:Raycast(Vector3.new(x, refY + 2, z), Vector3.new(0, -30, 0), ctx.ray)
    if hit then
        local y = hit.Position.Y + standHeight
        if math.abs(y - refY) <= MAX_HEIGHT_DELTA then
            return Vector3.new(x, y, z), true
        end
    end
    return Vector3.new(x, refY, z), false
end

-- Finds a ground point (the origin itself first, then rings around it) whose column to the sky
-- is free of solid parts and which can be reached from the origin along a free ground path.
local function findClearColumnNear(ctx, origin, standHeight, skyY)
    local topY = math.min(skyY, origin.Y + COLUMN_CHECK_HEIGHT)
    if isColumnClear(ctx, origin.X, origin.Z, topY, origin.Y) then
        return origin
    end

    for _, radius in ipairs(RING_RADII) do
        for i = 0, RING_ANGLES - 1 do
            local angle = (i / RING_ANGLES) * math.pi * 2
            local x = origin.X + math.cos(angle) * radius
            local z = origin.Z + math.sin(angle) * radius
            local point, hasFloor = groundPoint(ctx, x, z, origin.Y, standHeight)
            if hasFloor
                and isColumnClear(ctx, point.X, point.Z, math.min(skyY, point.Y + COLUMN_CHECK_HEIGHT), point.Y)
                and isBodyClear(ctx, point)
                and isPathClear(ctx, origin, point) then
                return point
            end
        end
    end
    return nil
end

-- Distance from the door pivot to the door's outer face along a direction.
local function getFrontExtent(door, doorPos, dir)
    local boxCF, size
    if door:IsA("Model") then
        local okBox, cf, sz = pcall(function()
            return door:GetBoundingBox()
        end)
        if okBox then
            boxCF, size = cf, sz
        end
    elseif door:IsA("BasePart") then
        boxCF, size = door.CFrame, door.Size
    end
    if not boxCF then return 0 end

    local localDir = boxCF:VectorToObjectSpace(dir)
    local support = (math.abs(localDir.X) * size.X + math.abs(localDir.Y) * size.Y + math.abs(localDir.Z) * size.Z) / 2
    local centerOffset = (boxCF.Position - doorPos):Dot(dir)
    return math.clamp(centerOffset + support, 0, MAX_FRONT_EXTENT)
end

-- A stand spot is valid when nothing blocks the line from the door and no solid part overlaps the body.
local function isSpotClear(ctx, doorPos, spot)
    local origin = Vector3.new(doorPos.X, spot.Y, doorPos.Z)
    if not isLineClear(ctx, origin, spot) then
        return false
    end
    return isBodyClear(ctx, spot)
end

local function faceDoor(spot, doorPos)
    -- Look at the door on the horizontal plane only, so the character does not tilt.
    return CFrame.lookAt(spot, Vector3.new(doorPos.X, spot.Y, doorPos.Z))
end

-- =========================================================
-- Saved transforms: matching and scoring
-- =========================================================

local function flatLookOf(cf)
    local v = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
    if v.Magnitude < 0.05 then return nil end
    return v.Unit
end

-- Lower score is better; nil means the saved point is not a plausible approach point for this door.
local function scoreSaved(saved, doorPos)
    local sPos = saved.cf.Position
    local toDoor = Vector3.new(doorPos.X - sPos.X, 0, doorPos.Z - sPos.Z)
    local flatDist = toDoor.Magnitude
    if flatDist < SAVED_MIN_STAND then return nil end
    if sPos.Y - doorPos.Y >= ROOF_MIN_DY then return nil end

    local angle = 1.0
    local look = flatLookOf(saved.cf)
    if look then
        angle = math.acos(math.clamp(look:Dot(toDoor.Unit), -1, 1))
        if angle > SAVED_MAX_ANGLE then return nil end
    end

    local pitch = math.abs(saved.cf.LookVector.Y)
    return math.abs(flatDist - doorOffsetDistance)
        + angle * 2
        + math.abs(sPos.Y - doorPos.Y) * 0.5
        + pitch * 2
        + (savedPenalty[saved.index] or 0)
end

-- Nearest plausible saved approach point within the tolerance (duplicates are scored, never merged).
local function pickSavedCandidate(doorPos)
    local best, bestScore, bestDist
    for _, saved in ipairs(savedTransforms) do
        local d = (saved.cf.Position - doorPos).Magnitude
        if d <= savedTolerance and not saved.dupOf then
            local score = scoreSaved(saved, doorPos)
            if score and (not bestScore or score < bestScore) then
                best, bestScore, bestDist = saved, score, d
            end
        end
    end
    return best, bestDist
end

-- Looks for an elevated saved point near the door that is likely a roof staging point.
-- Every saved record is examined (no limit). Returns { saved, pos, confirmed } or nil plus a reason.
-- "confirmed" means a solid surface lies just below the point (live geometry evidence).
local function findRoofPoint(ctx, doorPos, allowUnverified)
    local best, bestDist
    for _, saved in ipairs(savedTransforms) do
        if not saved.dupOf then
            local p = saved.cf.Position
            local dy = p.Y - doorPos.Y
            local hd = Vector3.new(p.X - doorPos.X, 0, p.Z - doorPos.Z).Magnitude
            if dy >= ROOF_MIN_DY and dy <= ROOF_MAX_DY and hd <= ROOF_RADIUS then
                local d3 = (p - doorPos).Magnitude
                if not bestDist or d3 < bestDist then
                    best, bestDist = saved, d3
                end
            end
        end
    end
    if not best then
        return nil, "no elevated saved point near the door"
    end

    local pos = best.cf.Position
    local confirmed = Workspace:Raycast(pos, Vector3.new(0, -ROOF_RAY, 0), ctx.ray) ~= nil
    if not confirmed and not allowUnverified then
        return nil, "roof point unverified (no surface below it)"
    end
    if not isBodyClear(ctx, pos) then
        return nil, "roof point blocked"
    end
    return { saved = best, pos = pos, confirmed = confirmed }, nil
end

-- =========================================================
-- Stand point computation
-- =========================================================

-- Computes a stand spot from the door's own orientation. Returns CFrame, found-clear flag, debug text.
local function computeStandCFrame(ctx, door, doorCF, standHeight)
    local doorPos = doorCF.Position
    local rawLook = Vector3.new(doorCF.LookVector.X, 0, doorCF.LookVector.Z)

    local directions
    local primary
    if rawLook.Magnitude >= 0.3 then
        primary = -rawLook.Unit
        if flipDirection then
            primary = -primary
        end
        directions = { primary }
        if autoDirection then
            table.insert(directions, -primary)
        end
    else
        -- Orientation is uncertain: evaluate the four horizontal directions.
        directions = {}
        if rawLook.Magnitude >= 0.05 then
            primary = -rawLook.Unit
            table.insert(directions, primary)
        end
        for _, d in ipairs({ Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) }) do
            table.insert(directions, d)
        end
        primary = directions[1]
    end

    for index, dir in ipairs(directions) do
        local extent = 0
        local baseDist = doorOffsetDistance
        local minDist = math.min(MIN_OFFSET, doorOffsetDistance)
        if useFaceOffset then
            extent = getFrontExtent(door, doorPos, dir)
            baseDist = math.max(doorOffsetDistance, extent + FACE_GAP)
            -- Never shorten past the door face plus the body half width.
            minDist = math.min(extent + BODY_HALF, baseDist)
        end

        local dist = baseDist
        while dist >= minDist - 0.001 do
            local spot = groundPoint(ctx, doorPos.X + dir.X * dist, doorPos.Z + dir.Z * dist, doorPos.Y, standHeight)
            if isSpotClear(ctx, doorPos, spot) then
                local info = string.format("direction #%d extent=%.2f dist=%.2f", index, extent, dist)
                return faceDoor(spot, doorPos), true, info
            end
            dist = dist - 0.5
        end
    end

    local fallback = groundPoint(ctx, doorPos.X + primary.X * doorOffsetDistance, doorPos.Z + primary.Z * doorOffsetDistance, doorPos.Y, standHeight)
    return faceDoor(fallback, doorPos), false, "no clear spot found"
end

-- Picks the stand point: a validated saved transform first, then the computed spot.
-- Returns { cf, verified, source, savedIndex, info }.
local function computeStand(ctx, door, doorCF, standHeight)
    local doorPos = doorCF.Position
    local unverifiedSaved = nil
    local savedWhy = nil

    if useSavedTransforms then
        local saved = pickSavedCandidate(doorPos)
        if saved then
            local spot = saved.cf.Position
            local ok = true
            if safetyCheck then
                local ground, hasFloor = groundPoint(ctx, spot.X, spot.Z, spot.Y, standHeight)
                if not hasFloor or math.abs(ground.Y - spot.Y) > 2.5 then
                    ok = false
                    savedWhy = "ground mismatch"
                elseif not isSpotClear(ctx, doorPos, spot) then
                    ok = false
                    savedWhy = "blocked"
                end
            end
            if ok and useFaceOffset then
                local dir = Vector3.new(spot.X - doorPos.X, 0, spot.Z - doorPos.Z)
                if dir.Magnitude > 0.01 then
                    local extent = getFrontExtent(door, doorPos, dir.Unit)
                    if dir.Magnitude < extent + BODY_HALF then
                        ok = false
                        savedWhy = "inside door face"
                    end
                end
            end

            local cf = faceDoor(spot, doorPos)
            if ok then
                return { cf = cf, verified = true, source = "saved#" .. saved.index, savedIndex = saved.index, info = "saved point accepted" }
            end
            unverifiedSaved = { cf = cf, index = saved.index }
            debugLog("saved #%d rejected: %s", saved.index, tostring(savedWhy))
        end
    end

    local cf, found, info = computeStandCFrame(ctx, door, doorCF, standHeight)
    if found then
        return { cf = cf, verified = true, source = "computed", info = info }
    end

    if unverifiedSaved then
        return {
            cf = unverifiedSaved.cf,
            verified = false,
            source = "saved#" .. unverifiedSaved.index .. " (unverified)",
            savedIndex = unverifiedSaved.index,
            info = "saved rejected: " .. tostring(savedWhy),
        }
    end
    return { cf = cf, verified = false, source = "computed (unverified)", info = info }
end

-- =========================================================
-- Movement primitives
-- =========================================================

-- Smooth straight-line move. Returns true, or false plus "stopped" / "interrupted".
local function flyTo(gen, targetCF, speed, keepGoing)
    local _, hrp = getAlive()
    if not hrp then return false, "stopped" end

    local startCF = hrp.CFrame
    local distance = (targetCF.Position - startCF.Position).Magnitude
    local duration = math.max(distance / math.max(speed, 1), 0.05)
    local elapsed = 0

    while elapsed < duration do
        if not isActive(gen) then return false, "stopped" end
        if keepGoing and not keepGoing() then return false, "interrupted" end
        local _, currentHrp = getAlive()
        if currentHrp ~= hrp then return false, "stopped" end
        elapsed = elapsed + RunService.Heartbeat:Wait()
        hrp.CFrame = startCF:Lerp(targetCF, math.clamp(elapsed / duration, 0, 1))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    hrp.CFrame = targetCF
    return true
end

-- Runs a list of { CFrame, speed, pauseAfter } steps. Returns "ok", "stopped" or "interrupted".
local function runSteps(gen, keepGoing, steps)
    for _, step in ipairs(steps) do
        local ok, reason = flyTo(gen, step[1], step[2], keepGoing)
        if not ok then
            return reason
        end
        if step[3] then
            task.wait(step[3])
        end
    end
    return "ok"
end

local function verifyArrival(standPos)
    local _, hrp = getAlive()
    return hrp ~= nil and (hrp.Position - standPos).Magnitude <= ARRIVAL_TOLERANCE
end

local function tapKey(key, downTime, gap)
    sendKey(key, true)
    task.wait(downTime)
    sendKey(key, false)
    task.wait(gap)
end

-- Input sequence: long E hold immediately on arrival, then optional 1-2-3-4 loops.
local function runInteraction(gen, keepGoing, door, token)
    local function canContinue()
        return isActive(gen)
            and getAlive() ~= nil
            and (not keepGoing or keepGoing())
            and (not door or door.Parent ~= nil)
            and (not token or token == interactionToken)
    end

    -- Long E hold first (no short presses before it).
    sendKey(Enum.KeyCode.E, true)
    local held = 0
    while held < holdDuration do
        if not canContinue() then
            sendKey(Enum.KeyCode.E, false)
            return false
        end
        task.wait(0.1)
        held = held + 0.1
    end
    sendKey(Enum.KeyCode.E, false)
    task.wait(0.2)

    -- Skip the number keys when the door already opened.
    if door and isDoorOpen(door) then
        return true
    end

    if useNumberKeys then
        local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
        for _ = 1, 3 do
            for _, key in ipairs(keys) do
                if not canContinue() then return false end
                tapKey(key, 0.05, 0.08)
            end
            task.wait(0.1)
        end
    end
    return true
end

-- =========================================================
-- High-altitude holds (no-doors wait and Pumpkin hold)
-- =========================================================

-- Climbs to the altitude (never descends), then stays motionless until shouldContinue() turns false.
local function holdAtAltitude(gen, stateName, altitude, shouldContinue)
    if not shouldContinue() then return "exit" end
    local _, hrp, hum = getAlive()
    if not hrp then return "aborted" end

    setState(stateName)
    if announcedState ~= stateName then
        announcedState = stateName
        if stateName == "PUMPKIN_HIGH_HOLD" then
            notify("🎃 اليقطين موجود", string.format("ننتظر على ارتفاع %d لين تختفي.", altitude), 3)
        else
            notify("⏳ ما فيه أبواب", string.format("ننتظر على ارتفاع %d لين يظهر باب.", altitude), 3)
        end
    end
    setProtection(true)

    local startPos = hrp.Position
    local targetY = math.max(altitude, startPos.Y)
    if targetY - startPos.Y > 1 then
        local ascendPoint = startPos
        if safetyCheck then
            local ctx = buildContext(nil)
            local found = findClearColumnNear(ctx, startPos, getStandHeight(hrp, hum), targetY)
            if found then
                ascendPoint = found
            else
                debugLog("no safe ascent column for the hold, using a straight ascent")
            end
        end
        local rotation = hrp.CFrame.Rotation
        local steps = {}
        if (ascendPoint - startPos).Magnitude > 0.2 then
            table.insert(steps, { CFrame.new(ascendPoint) * rotation, APPROACH_SPEED })
        end
        table.insert(steps, { CFrame.new(ascendPoint.X, targetY, ascendPoint.Z) * rotation, ascendSpeed })
        local result = runSteps(gen, shouldContinue, steps)
        if result ~= "ok" then
            return result
        end
    end

    local _, holdHrp = getAlive()
    if not holdHrp then return "aborted" end
    lockedCFrame = holdHrp.CFrame
    while isActive(gen) and getAlive() and shouldContinue() do
        task.wait(HOLD_POLL)
    end
    releaseLock()
    return "exit"
end

-- =========================================================
-- Interaction readiness (arrival synchronization)
-- =========================================================

-- Returns true once the character is stationary at the stand point and the door (and its prompt, if one
-- is found) is valid. Otherwise returns false plus a reason such as "distance too large".
local function prepareInteraction(gen, keepGoing, door, standCF)
    local standPos = standCF.Position

    local function check()
        if not isActive(gen) then return false, "interrupted" end
        if keepGoing and not keepGoing() then return false, "interrupted" end
        local _, hrp = getAlive()
        if not hrp then return false, "character unavailable" end
        if not door.Parent then return false, "target changed" end
        if (hrp.Position - standPos).Magnitude > READY_DISTANCE then return false, "distance too large" end
        local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and not prompt.Enabled then return false, "prompt unavailable" end
        return true
    end

    local ok, reason = check()
    if not ok and reason == "distance too large" then
        -- Recovery: put the character back on the stand point once (the lock normally prevents drifting).
        local _, hrp = getAlive()
        if hrp then
            hrp.CFrame = standCF
        end
        task.wait(0.1)
        ok, reason = check()
    end
    if not ok then
        return false, reason
    end

    -- Stabilization: the character must stay put for the whole interval before any input is sent.
    local waited = 0
    while waited < stabilizeTime do
        task.wait(0.1)
        waited = waited + 0.1
        ok, reason = check()
        if not ok then
            if reason == "distance too large" then
                reason = "not stabilized"
            end
            return false, reason
        end
    end
    return true
end

-- =========================================================
-- Pumpkin system (independent of the door system)
-- =========================================================

local function pumpkinHoldWanted()
    return pumpkinHoldEnabled and pumpkinPresent
end

local function trackWanted()
    return pumpkinTrackEnabled and not pumpkinHoldWanted() and next(pumpkinHolders) ~= nil
end

local function higherPriorityWanted()
    return pumpkinHoldWanted() or trackWanted()
end

-- Camera follow: remembers the previous subject/type and restores them on every exit path.
local function followTargetCamera(targetChar)
    local cam = Workspace.CurrentCamera
    local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    if not cam or not hum then return end
    if not savedCamera then
        savedCamera = { subject = cam.CameraSubject, cameraType = cam.CameraType }
    end
    if cam.CameraSubject ~= hum then
        pcall(function() cam.CameraSubject = hum end)
    end
end

local function restoreCamera()
    if not savedCamera then return end
    local saved = savedCamera
    savedCamera = nil
    local cam = Workspace.CurrentCamera
    if not cam then return end
    pcall(function()
        cam.CameraType = saved.cameraType
        if saved.subject and saved.subject.Parent then
            cam.CameraSubject = saved.subject
        else
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                cam.CameraSubject = hum
            end
        end
    end)
end

local function quickTap(key)
    sendKey(key, true)
    task.wait(0.03)
    sendKey(key, false)
end

-- Probes once whether the executor accepts mouse button events (a harmless right-button release).
local function probeMouseSupport()
    if mouseSupported == nil then
        mouseSupported = pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
        end)
    end
    return mouseSupported
end

local function clickRight()
    local cam = Workspace.CurrentCamera
    local size = cam and cam.ViewportSize or Vector2.new(800, 600)
    local x = size.X / 2
    local y = size.Y / 2
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 1, true, game, 0)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(x, y, 1, false, game, 0)
    end)
end

local function stopPumpkinInput()
    pumpkinInputToken = pumpkinInputToken + 1
end

-- The single Pumpkin input worker: key sequence, right clicks and discrete E taps (never held).
-- It is only started by the tracker and is never used for door interaction.
local function startPumpkinInputWorker(gen, getTargetRoot)
    pumpkinInputToken = pumpkinInputToken + 1
    local token = pumpkinInputToken
    local cfg = PUMPKIN_INPUT
    local clickOk = probeMouseSupport()
    if not clickOk then
        notify("⚠️ الماوس غير مدعوم", "الـ executor ما يدعم ضغط الماوس الأيمن، يكمل الباقي بدونه.", 4)
    end

    task.spawn(function()
        local stepIndex = 1
        local tapsDone = 0
        local nextTap = 0
        local waitUntil = 0
        local nextClick = 0
        local nextE = 0

        while isActive(gen) and token == pumpkinInputToken do
            if os.clock() >= waitUntil and os.clock() >= nextTap then
                local step = cfg.sequence[stepIndex]
                quickTap(step.key)
                tapsDone = tapsDone + 1
                nextTap = os.clock() + step.tapInterval
                if tapsDone >= step.taps then
                    tapsDone = 0
                    waitUntil = os.clock() + (step.after or 0)
                    stepIndex = stepIndex + 1
                    if stepIndex > #cfg.sequence then
                        stepIndex = 1
                    end
                end
            end

            if clickOk and os.clock() >= nextClick then
                clickRight()
                nextClick = os.clock() + cfg.rightClickInterval
            end

            if os.clock() >= nextE then
                local root = getTargetRoot()
                local _, hrp = getAlive()
                if root and hrp and (root.Position - hrp.Position).Magnitude <= cfg.eRange then
                    quickTap(Enum.KeyCode.E)
                end
                nextE = os.clock() + cfg.eTapInterval
            end

            task.wait(0.05)
        end

        for _, step in ipairs(cfg.sequence) do
            sendKey(step.key, false)
        end
        sendKey(Enum.KeyCode.E, false)
    end)
end

-- Nearest other player that currently holds a Pumpkin and has a living character.
local function chooseTrackTarget()
    local _, hrp = getAlive()
    if not hrp then return nil end
    local best, bestDist
    for _, plr in pairs(pumpkinHolders) do
        local ch = plr.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if root and hum and hum.Health > 0 then
            local d = (root.Position - hrp.Position).Magnitude
            if not bestDist or d < bestDist then
                best, bestDist = plr, d
            end
        end
    end
    return best
end

-- Picks a spot next to the target that is not inside geometry (behind, right, left, front, then above).
local function pickFollowPosition(ctx, root)
    local rp = root.Position
    local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if look.Magnitude < 0.05 then
        look = Vector3.new(0, 0, -1)
    end
    look = look.Unit
    local right = look:Cross(Vector3.yAxis)
    for _, dir in ipairs({ -look, right, -right, look }) do
        local pos = rp + dir * followDistance
        if isLineClear(ctx, rp, pos) and isBodyClear(ctx, pos) then
            return pos
        end
    end
    return rp + Vector3.new(0, followDistance, 0)
end

-- Follows one Pumpkin holder until the target becomes invalid or a higher priority takes over.
local function trackPumpkinTarget(gen, shouldContinue)
    local targetPlayer = chooseTrackTarget()
    if not targetPlayer then return "exit" end

    setState("PUMPKIN_TRACKING")
    if announcedState ~= "PUMPKIN_TRACKING" then
        announcedState = "PUMPKIN_TRACKING"
        notify("🎯 تتبع اليقطين", "اللاعب: " .. targetPlayer.Name, 3)
    end
    setProtection(true)

    local ctx = buildContext(nil)

    local function targetRoot()
        local ch = targetPlayer.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if root and hum and root.Parent and hum.Health > 0 then
            return root, ch
        end
        return nil
    end

    local function keep()
        return shouldContinue()
            and targetPlayer.Parent == Players
            and pumpkinHolders[targetPlayer.Name] ~= nil
            and targetRoot() ~= nil
    end

    local result = "exit"

    -- Far away: fly through the sky first, then close in with the follow loop.
    local _, hrp = getAlive()
    local firstRoot = targetRoot()
    if hrp and firstRoot and (firstRoot.Position - hrp.Position).Magnitude > TRACK_FAR then
        local startPos = hrp.Position
        local skyY = math.max(flightHeight, math.max(startPos.Y, firstRoot.Position.Y) + 30)
        local rotation = hrp.CFrame.Rotation
        local travel = runSteps(gen, keep, {
            { CFrame.new(startPos.X, skyY, startPos.Z) * rotation, ascendSpeed, 0.05 },
            { CFrame.new(firstRoot.Position.X, skyY, firstRoot.Position.Z) * rotation, flightSpeed, 0.05 },
        })
        if travel == "stopped" then
            result = "aborted"
        end
    end

    if result == "exit" and isActive(gen) and keep() then
        if pumpkinInputEnabled then
            startPumpkinInputWorker(gen, function()
                return (targetRoot())
            end)
        end

        local desired = nil
        local lastPick = 0
        while isActive(gen) and keep() do
            local root, targetChar = targetRoot()
            if not root then
                break
            end
            if not desired or os.clock() - lastPick >= 0.25 then
                desired = pickFollowPosition(ctx, root)
                lastPick = os.clock()
                if pumpkinCameraEnabled then
                    followTargetCamera(targetChar)
                end
            end

            local dt = RunService.Heartbeat:Wait()
            local _, curHrp = getAlive()
            local rootNow = targetRoot()
            if not curHrp or not rootNow then
                break
            end

            local current = curHrp.Position
            local toDesired = desired - current
            local dist = toDesired.Magnitude
            local newPos = current
            if dist > 0.05 then
                newPos = current + toDesired.Unit * math.min(dist, TRACK_SPEED * dt)
            end
            curHrp.CFrame = CFrame.lookAt(newPos, Vector3.new(rootNow.Position.X, newPos.Y, rootNow.Position.Z))
            curHrp.AssemblyLinearVelocity = Vector3.zero
            curHrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    stopPumpkinInput()
    restoreCamera()
    return result
end

-- =========================================================
-- Door processing
-- =========================================================

-- Returns "done", "failed", "skipped" (plus a reason) or "aborted".
local function processDoor(doorData, gen, keepGoing)
    local door = doorData.Object
    local _, hrp, hum = getAlive()
    if not hrp then return "aborted" end

    setState("FIND_DOOR")
    setProtection(true)

    local doorCF = getObjectCFrame(door)
    if not doorCF then return "skipped", "نوع الباب غير مدعوم" end

    setState("VERIFY_DOOR")
    local ctx = buildContext(door)
    local standHeight = getStandHeight(hrp, hum)
    local stand = computeStand(ctx, door, doorCF, standHeight)
    local standCF = stand.cf
    local standPos = standCF.Position
    local rotation = standCF.Rotation
    debugLog("door (%.1f, %.1f, %.1f) | stand source=%s verified=%s | %s",
        doorCF.Position.X, doorCF.Position.Y, doorCF.Position.Z, stand.source, tostring(stand.verified), stand.info or "")

    if not stand.verified then
        debugLog("SP verification failed")
        notify("⚠️ SP verification failed", "نجرب الطيران القديم للباب.", 3)
    end

    local function at(pos)
        return CFrame.new(pos) * rotation
    end

    local function currentPosition()
        local _, h = getAlive()
        return h and h.Position or nil
    end

    local startPos = hrp.Position
    local travelY = math.max(flightHeight, standPos.Y + 30)
    if startPos.Y > travelY then
        travelY = startPos.Y
    end

    -- Already at the stand point: do not restart any route.
    local arrived = verifyArrival(standPos)

    -- 0. Roof staging first: fly to the roof point above the door, then step off in front of it.
    if not arrived and safetyCheck and stand.verified and useSavedTransforms then
        local roof, roofWhy = findRoofPoint(ctx, doorCF.Position, useUnverifiedRoof)
        if roof then
            local roofPos = roof.pos
            local ascendPoint = startPos
            local columnsOk = true
            if startPos.Y < travelY - 1 then
                ascendPoint = findClearColumnNear(ctx, startPos, standHeight, travelY)
                columnsOk = ascendPoint ~= nil
            end
            local exitPoint = Vector3.new(standPos.X, roofPos.Y, standPos.Z)
            local roofColumnOk = isColumnClear(ctx, roofPos.X, roofPos.Z, travelY, roofPos.Y)
            local exitOk = isPathClear(ctx, roofPos, exitPoint)
                and isColumnClear(ctx, standPos.X, standPos.Z, roofPos.Y, standPos.Y)

            if columnsOk and roofColumnOk and exitOk then
                setState("ROOF_STAGING")
                debugLog("roof staging point #%d (%s)", roof.saved.index, roof.confirmed and "confirmed" or "unverified")
                local stepsA = {}
                if (ascendPoint - startPos).Magnitude > 0.2 then
                    table.insert(stepsA, { at(ascendPoint), APPROACH_SPEED })
                end
                if startPos.Y < travelY - 1 then
                    table.insert(stepsA, { at(Vector3.new(ascendPoint.X, travelY, ascendPoint.Z)), ascendSpeed, 0.05 })
                end
                table.insert(stepsA, { at(Vector3.new(roofPos.X, travelY, roofPos.Z)), flightSpeed, 0.05 })
                table.insert(stepsA, { at(roofPos), flightSpeed })
                if runSteps(gen, keepGoing, stepsA) ~= "ok" then return "aborted" end

                if verifyArrival(roofPos) then
                    task.wait(0.15)
                    local resultB = runSteps(gen, keepGoing, {
                        { at(exitPoint), APPROACH_SPEED },
                        { standCF, flightSpeed },
                    })
                    if resultB ~= "ok" then return "aborted" end
                    arrived = verifyArrival(standPos)
                else
                    debugLog("roof staging point was not reached")
                end
            else
                debugLog("roof route unavailable (columns=%s roof=%s exit=%s)", tostring(columnsOk), tostring(roofColumnOk), tostring(exitOk))
            end
        else
            debugLog("no usable roof point: %s", tostring(roofWhy))
        end
    end

    -- 1. Preferred safe route (only when the stand point itself is verified).
    if not arrived and safetyCheck and stand.verified then
        setState("SAFE_APPROACH")
        local sPos = currentPosition()
        if not sPos then return "aborted" end
        local safeTravelY = math.max(travelY, sPos.Y)
        local ascendPoint = sPos
        local columnsOk = true
        if sPos.Y < safeTravelY - 1 then
            ascendPoint = findClearColumnNear(ctx, sPos, standHeight, safeTravelY)
            columnsOk = ascendPoint ~= nil
        end
        local landPoint = nil
        if columnsOk then
            landPoint = findClearColumnNear(ctx, standPos, standHeight, safeTravelY)
        end

        if columnsOk and landPoint then
            local steps = {}
            if (ascendPoint - sPos).Magnitude > 0.2 then
                table.insert(steps, { at(ascendPoint), APPROACH_SPEED })
            end
            if sPos.Y < safeTravelY - 1 then
                table.insert(steps, { at(Vector3.new(ascendPoint.X, safeTravelY, ascendPoint.Z)), ascendSpeed, 0.05 })
            end
            table.insert(steps, { at(Vector3.new(landPoint.X, safeTravelY, landPoint.Z)), flightSpeed, 0.05 })
            table.insert(steps, { at(landPoint), flightSpeed })
            if (landPoint - standPos).Magnitude > 0.2 then
                table.insert(steps, { standCF, APPROACH_SPEED })
            end
            if runSteps(gen, keepGoing, steps) ~= "ok" then return "aborted" end
            arrived = verifyArrival(standPos)
            if not arrived then
                debugLog("safe route finished away from the stand point")
            end
        else
            debugLog("no safe vertical column available, switching to the legacy flight")
        end
    end

    -- 2. Legacy flight fallback (also the normal route when the safety check is disabled).
    if not arrived then
        if safetyCheck and not fallbackEnabled then
            return "skipped", "فشل المسار الآمن والطيران القديم معطّل"
        end
        setState("LEGACY_FLIGHT_FALLBACK")
        for attempt = 1, APPROACH_RETRIES do
            local from = currentPosition()
            if not from then return "aborted" end
            local flyY = math.max(travelY, from.Y)
            local steps = {
                { at(Vector3.new(from.X, flyY, from.Z)), ascendSpeed, 0.05 },
                { at(Vector3.new(standPos.X, flyY, standPos.Z)), flightSpeed, 0.05 },
                { standCF, flightSpeed },
            }
            if runSteps(gen, keepGoing, steps) ~= "ok" then return "aborted" end
            if verifyArrival(standPos) then
                arrived = true
                break
            end
            debugLog("legacy flight attempt %d/%d did not reach the stand point", attempt, APPROACH_RETRIES)
            task.wait(0.3)
        end
        if not arrived then
            return "skipped", "ما وصلت للباب بعد " .. APPROACH_RETRIES .. " محاولات طيران"
        end
    end

    -- 3. Arrived: lock the position, freeze movement and aim the camera.
    setState("INTERACT_WITH_DOOR")
    local _, arrivedHrp, arrivedHum = getAlive()
    if not arrivedHrp then return "aborted" end
    lockedCFrame = standCF
    freezeMovement(arrivedHum)
    if anchorMode then
        arrivedHrp.Anchored = true
        anchoredByScript = true
    end
    if cameraLookEnabled then
        cameraTarget = doorCF.Position
    end
    debugLog("Arrived | distance to door pivot: %.2f | body clear: %s",
        (arrivedHrp.Position - doorCF.Position).Magnitude, tostring(isBodyClear(ctx, arrivedHrp.Position)))

    -- 4. Press only after the character is stable and the door/prompt are valid. Bounded attempts, verified result.
    interactionToken = interactionToken + 1
    local token = interactionToken
    local attempts = 0
    local completed = true
    local opened = false
    local lastReason = nil
    while attempts < maxAttempts and isActive(gen) and token == interactionToken do
        attempts = attempts + 1
        local ready, reason = prepareInteraction(gen, keepGoing, door, standCF)
        if not ready then
            lastReason = reason
            debugLog("attempt %d/%d not ready: %s", attempts, maxAttempts, tostring(reason))
            if reason == "target changed" then
                -- The door object disappeared: treat it as opened.
                opened = true
                break
            end
            if reason == "interrupted" or reason == "character unavailable" then
                completed = false
                break
            end
            task.wait(0.4)
        else
            interacting = true
            completed = runInteraction(gen, keepGoing, door, token)
            interacting = false
            if not completed then
                if not door.Parent then
                    completed = true
                    opened = true
                else
                    lastReason = "interrupted"
                end
                break
            end
            opened = isDoorOpen(door)
            debugLog("attempt %d/%d finished | opened=%s", attempts, maxAttempts, tostring(opened))
            if opened then break end
            lastReason = "الباب ما استجاب"
            task.wait(0.4) -- let the state replicate before revalidating for the next attempt
        end
    end
    releaseLock()

    if not completed or not isActive(gen) or token ~= interactionToken then return "aborted" end

    -- Remember which saved point worked, so a bad one is ranked lower next time.
    if stand.savedIndex then
        if opened then
            savedPenalty[stand.savedIndex] = nil
        else
            savedPenalty[stand.savedIndex] = (savedPenalty[stand.savedIndex] or 0) + SAVED_FAIL_PENALTY
        end
    end

    if opened then return "done" end
    return "failed", lastReason
end

-- =========================================================
-- State controller (the only movement driver)
-- =========================================================

local function pumpkinWatcher(gen)
    while isActive(gen) do
        local present = checkPumpkin()
        if present ~= pumpkinPresent then
            pumpkinPresent = present
            debugLog("Pumpkin %s", present and "appeared" or "disappeared")
        end

        if pumpkinTrackEnabled then
            local holders = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and hasPumpkin(plr.Name) then
                    holders[plr.Name] = plr
                end
            end
            pumpkinHolders = holders
        else
            pumpkinHolders = {}
        end
        task.wait(PUMPKIN_POLL)
    end
end

local function automationLoop(gen)
    -- Never run two loops at the same time.
    while loopRunning do
        if not isActive(gen) then return end
        task.wait(0.05)
    end
    if not isActive(gen) then return end

    loopRunning = true
    local processed = 0

    local function noPumpkin()
        return not higherPriorityWanted()
    end

    local function waitStillValid()
        return not higherPriorityWanted() and #getDoors(false) == 0
    end

    local runOk, runErr = pcall(function()
        while isActive(gen) do
            local _, hrp = getAlive()
            if not hrp then
                -- Character unavailable: pause until it respawns.
                setState("IDLE")
                task.wait(0.5)
            elseif pumpkinHoldWanted() then
                holdAtAltitude(gen, "PUMPKIN_HIGH_HOLD", pumpkinAltitude, pumpkinHoldWanted)
                task.wait(0.05)
            elseif trackWanted() then
                trackPumpkinTarget(gen, trackWanted)
                task.wait(0.05)
            else
                local doors = getDoors(false)
                if #doors > 0 then
                    announcedState = nil
                    local doorData = doors[1]
                    notify(
                        "🚪 باب " .. (processed + 1) .. " من " .. (processed + #doors),
                        string.format("المسافة: %.0f", doorData.Distance),
                        2
                    )
                    local result, reason = processDoor(doorData, gen, noPumpkin)
                    if result == "done" then
                        visitedDoors[doorData.Object] = true
                        doorResults[doorData.Object] = "تم الفتح"
                        processed = processed + 1
                        notify("✅ تم", "انفتح الباب، ننتقل للتالي.", 2)
                    elseif result == "failed" then
                        visitedDoors[doorData.Object] = true
                        doorResults[doorData.Object] = "ما انفتح: " .. tostring(reason)
                        processed = processed + 1
                        notify("❌ ما انفتح", "بعد " .. maxAttempts .. " محاولات (" .. tostring(reason) .. ")، ننتقل للباب التالي.", 3)
                    elseif result == "skipped" then
                        visitedDoors[doorData.Object] = true
                        doorResults[doorData.Object] = "تخطي: " .. tostring(reason)
                        processed = processed + 1
                        notify("⏭️ تخطي", tostring(reason), 3)
                    else
                        task.wait(0.3)
                    end
                elseif noDoorWaitEnabled then
                    holdAtAltitude(gen, "NO_DOORS_HIGH_WAIT", waitAltitude, waitStillValid)
                    task.wait(0.05)
                else
                    setState("IDLE")
                    if protectionActive then setProtection(false) end
                    task.wait(1)
                end
            end
        end
    end)

    -- No yields below this point, so a waiting new loop cannot interleave.
    loopRunning = false
    stopPumpkinInput()
    restoreCamera()
    releaseAllKeys()
    setProtection(false)
    setState("IDLE")

    if not runOk then
        warn("[HalloweenDoors] Automation error: " .. tostring(runErr))
        notify("❌ خطأ", "توقفت الأتمتة بسبب خطأ، شوف الـ Console.", 4)
        if gen == runGeneration and autoToggle then
            pcall(function() autoToggle:Set(false) end)
        end
    end
end

local function startAutomation()
    runGeneration = runGeneration + 1
    local gen = runGeneration
    autoMoveEnabled = true
    pumpkinPresent = false
    pumpkinHolders = {}
    announcedState = nil
    table.clear(visitedDoors)
    table.clear(doorResults)
    task.spawn(pumpkinWatcher, gen)
    task.spawn(automationLoop, gen)
end

local function stopAutomation()
    setState("STOPPING")
    autoMoveEnabled = false
    runGeneration = runGeneration + 1
    interacting = false
    interactionToken = interactionToken + 1
    pumpkinPresent = false
    pumpkinHolders = {}
    announcedState = nil
    stopPumpkinInput()
    restoreCamera()
    releaseAllKeys()
    setProtection(false)
    setState("IDLE")
end

local function unload()
    if unloaded then return end
    unloaded = true
    stopAutomation()
    stopESP()
    cameraTarget = nil
    pcall(function() RunService:UnbindFromRenderStep(CAMERA_BIND) end)
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    releaseAllKeys()
    pcall(function() Rayfield:Destroy() end)
end

